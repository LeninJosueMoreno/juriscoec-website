---
import { Image } from 'astro:assets'
import SectionTitle from './ui/SectionTitle.astro'

import { partners } from '../data/partners'
---

<section id='nosotros' class='py-24 overflow-hidden relative'>
  <div class='container mx-auto mt-5'>
    <div class='about-heading'>
      <p class='about-eyebrow'>
        <span aria-hidden='true'>§</span> Sobre nosotros · la firma que te acompaña
      </p>
      <h2>
        Experiencia y compromiso<br class='hidden sm:block' /> en cada caso
      </h2>
    </div>

    <div class='about-pillars'>
      <article
        class='about-pillar invisible intersect:visible intersect:animate-fade-up intersect-once'
      >
        <Image
          width={96}
          height={96}
          src='/images/png-icons/legal.png'
          alt=''
          class='pillar-icon'
        />
        <h4>Experiencia legal integral</h4>
        <p>
          Soluciones legales completas y personalizadas para cada cliente, con
          representación sólida en cada caso.
        </p>
      </article>
      <article
        class='about-pillar invisible intersect:visible intersect:animate-fade-up intersect-once'
      >
        <Image
          width={96}
          height={96}
          src='/images/png-icons/compromiso.png'
          alt=''
          class='pillar-icon'
        />
        <h4>Compromiso total</h4>
        <p>
          Entendemos tus necesidades y te acompañamos con claridad durante todo
          el proceso legal.
        </p>
      </article>
      <article
        class='about-pillar invisible intersect:visible intersect:animate-fade-up intersect-once'
      >
        <Image
          width={96}
          height={96}
          src='/images/png-icons/respuesta.png'
          alt=''
          class='pillar-icon'
        />
        <h4>Respuesta inmediata</h4>
        <p>
          Estamos disponibles para responder de forma oportuna y eficiente
          cuando más lo necesitas.
        </p>
      </article>
    </div>

    <!-- Socios -->
    <div id='equipo' class='mt-24'>
      <SectionTitle title='Nuestros Socios' />

      <p class='team-intro'>
        Conoce a las abogadas que te acompañan en Colombia y Ecuador.
      </p>
      <div class='partners-grid'>
        {
          partners.map((partner) => (
            <article class='partner-card'>
              <a
                href={`/equipo/${partner.slug}/`}
                class='partner-link'
                aria-label={`Ver perfil de ${partner.name}`}
              >
                <div
                  class='partner-photo-frame'
                  transition:name={`partner-${partner.slug}`}
                >
                  <img
                    src={partner.image}
                    alt={partner.name}
                    width='900'
                    height='1200'
                    loading='lazy'
                    decoding='async'
                    class='partner-photo'
                  />
                </div>
                <h3 class='partner-name'>
                  <span>{partner.name}</span>
                </h3>
              </a>
              <a class='partner-email' href={`mailto:${partner.email}`}>
                {partner.email}
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  #equipo {
    scroll-margin-top: 7rem;
  }
  .team-intro {
    max-width: 42rem;
    margin: -1rem 0 2.5rem;
    line-height: 1.7;
    color: var(--color-secondary);
  }
  .partners-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.5rem, 4vw, 3rem);
    max-width: 54rem;
    margin-inline: auto;
  }
  .about-heading {
    max-width: 48rem;
    margin: 0 auto clamp(3rem, 7vw, 5rem);
    text-align: center;
  }
  .about-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 1.25rem;
    color: var(--color-primary-dark);
    font-size: 0.95rem;
    font-weight: 700;
  }
  .about-eyebrow span {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    background: var(--color-primary);
    color: white;
    font-size: 1rem;
  }
  .about-heading h2 {
    color: var(--color-foreground);
    font-size: clamp(2rem, 4.5vw, 3.5rem);
    font-weight: 750;
    letter-spacing: -0.055em;
    line-height: 0.98;
  }
  .about-pillars {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(2rem, 5vw, 5rem);
    max-width: 75rem;
    margin: 0 auto;
    text-align: center;
  }
  .about-pillar {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .pillar-icon {
    width: 5.5rem;
    height: 5.5rem;
    object-fit: contain;
    margin-bottom: 1.75rem;
    filter: saturate(0.8);
  }
  .about-pillar h4 {
    max-width: 18rem;
    margin-bottom: 1rem;
    color: var(--color-foreground);
    font-size: clamp(1.15rem, 2vw, 1.45rem);
    font-weight: 700;
    line-height: 1.25;
    text-transform: none;
  }
  .about-pillar p {
    max-width: 22rem;
    color: var(--color-foreground);
    font-size: 1rem;
    line-height: 1.65;
  }
  @media (max-width: 767px) {
    .about-pillars {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
    .about-heading h2 {
      font-size: clamp(2rem, 10vw, 2.75rem);
    }
  }
  .partner-card {
    min-width: 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--color-muted);
    border-radius: 12px;
    background: var(--color-light);
  }
  .partner-photo-frame {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 4;
    max-height: clamp(24rem, 42vw, 31rem);
    overflow: hidden;
    background: var(--color-muted-warm);
  }
  .partner-photo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .partner-link {
    display: block;
    color: inherit;
    text-decoration: none;
  }
  .partner-link:focus-visible {
    outline: 3px solid var(--color-secondary);
    outline-offset: -3px;
  }
  .partner-name {
    padding: 1.5rem 1.5rem 0.45rem;
    font-size: clamp(1.25rem, 2vw, 1.6rem);
    font-weight: 650;
    line-height: 1.3;
    letter-spacing: -0.025em;
  }
  .partner-name span {
    position: relative;
    display: inline-block;
  }
  .partner-name span::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: -0.25rem;
    left: 0;
    height: 2px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 250ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .partner-link:hover .partner-name span::after,
  .partner-link:focus-visible .partner-name span::after {
    transform: scaleX(1);
  }
  .partner-email {
    display: block;
    align-self: flex-start;
    max-width: 100%;
    padding: 0 1.5rem 1.5rem;
    color: var(--color-secondary);
    font-size: 0.95rem;
    overflow-wrap: anywhere;
    text-underline-offset: 3px;
  }
  .partner-email:focus-visible {
    outline: 3px solid var(--color-secondary);
    outline-offset: -3px;
  }
  @media (prefers-reduced-motion: reduce) {
    .partner-name span::after {
      transition: none;
    }
  }
  @media (max-width: 639px) {
    .partners-grid {
      grid-template-columns: minmax(0, 1fr);
      max-width: 30rem;
    }
  }
</style>

---
import Layout from '../../layouts/Layout.astro'
import Header from '../../components/Header.astro'
import { partners } from '../../data/partners'

export const prerender = true
export function getStaticPaths() {
  return partners.map((partner) => ({
    params: { slug: partner.slug },
    props: { partner },
  }))
}
const { partner } = Astro.props
---

<Layout
  title={`${partner.name} | Z&O`}
  description={`Conoce la trayectoria y las áreas de práctica de ${partner.name}, abogada en Colombia y Ecuador.`}
>
  <Header />
  <main class='profile'>
    <a class='back-link' href='/#equipo'>Volver al equipo</a>
    <article class='profile-grid'>
      <img
        transition:name={`partner-${partner.slug}`}
        class='portrait'
        src={partner.image}
        alt={partner.name}
        width='900'
        height='1200'
        fetchpriority='high'
      />
      <div class='profile-content'>
        <p class='role'>{partner.role}</p>
        <h1>{partner.name}</h1>
        <a class='profile-email' href={`mailto:${partner.email}`}>
          {partner.email}
        </a>
        <section aria-labelledby='trayectoria'>
          <h2 id='trayectoria'>Trayectoria profesional</h2>
          <p class='biography'>{partner.description}</p>
        </section>
        <section aria-labelledby='areas'>
          <h2 id='areas'>Áreas de práctica</h2>
          <ul>
            {partner.specialties.map((specialty) => <li>{specialty}</li>)}
          </ul>
        </section>
        <a class='contact-link' href='/#contacto'>Hablemos de tu caso</a>
      </div>
    </article>
  </main>
</Layout>

<style>
  .profile {
    max-width: 72rem;
    margin-inline: auto;
    padding: clamp(2rem, 5vw, 4rem) 1.5rem 5rem;
  }
  .back-link {
    display: inline-block;
    margin-bottom: 2rem;
    color: var(--color-secondary-dark);
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .profile-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }
  .portrait {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: 12px;
  }
  .role {
    color: var(--color-secondary);
    margin-bottom: 0.75rem;
    font-size: 0.9rem;
  }
  h1 {
    font-size: clamp(2rem, 3.5vw, 3rem);
    font-weight: 650;
    line-height: 1.15;
    letter-spacing: -0.035em;
    margin-bottom: 0.5rem;
  }
  .profile-email {
    display: inline-block;
    margin-bottom: 2rem;
    color: var(--color-secondary-dark);
    overflow-wrap: anywhere;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  h2 {
    font-size: 1.125rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
  }
  section {
    margin-bottom: 2rem;
  }
  .biography {
    line-height: 1.85;
  }
  ul {
    padding-left: 1.25rem;
    list-style: disc;
    line-height: 1.9;
  }
  li::marker {
    color: var(--color-primary);
  }
  .contact-link {
    display: inline-block;
    padding: 0.9rem 1.5rem;
    background: var(--color-secondary-dark);
    color: white;
    border-radius: 8px;
    font-weight: 500;
  }
  .contact-link:hover {
    background: var(--color-secondary-darker);
  }
  a:focus-visible {
    outline: 3px solid var(--color-secondary);
    outline-offset: 5px;
  }
  @media (max-width: 767px) {
    .profile-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .portrait {
      max-width: 28rem;
      margin-inline: auto;
    }
  }
</style>
